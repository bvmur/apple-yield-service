        {
          "name": "01 GET список месяцев (фильтр)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/months?temp_from=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "months"
              ],
              "query": [
                {
                  "key": "temp_from",
                  "value": "12"
                }
              ]
            },
            "description": "Только опубликованные. is_mine = 1, если создатель — текущий пользователь."
          }
        },
        {
          "name": "02 POST создать месяц (фото + видео)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/months",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "months"
              ]
            },
            "description": "Файлы уходят в MinIO под латинскими именами, ссылки — в БД. id сохраняется в переменную monthId.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Ноябрь",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": "/Users/murad/bmstu_web/draft-web/static/media/default.jpg"
                },
                {
                  "key": "video",
                  "type": "file",
                  "src": "/Users/murad/bmstu_web/draft-web/static/media/default.mp4"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) { pm.collectionVariables.set('monthId', body.data.id); }",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
